rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "jalban.dacompsc@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isBarOwner(ownerId) {
      return isSignedIn() && (isAdmin() || request.auth.uid == ownerId);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // --- BARS ---
    match /bars/{barId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // --- EVENTS ---
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // --- ARTISTS ---
    match /artists/{artistId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- SONGS ---
    match /songs/{songId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- PLAYLISTS ---
    match /playlists/{playlistId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // --- CATEGORIES ---
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        resource.data.barId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().total is number && incoming().total >= 0;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- SUBSCRIPTION PLANS ---
    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- SUBSCRIPTIONS ---
    match /subscriptions/{subId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- TABLE RESERVATIONS ---
    match /tableReservations/{resId} {
      allow read: if true;
      allow create: if request.resource.data.barId is string &&
        request.resource.data.barName is string &&
        request.resource.data.customerName is string &&
        request.resource.data.date is string &&
        request.resource.data.guestsCount is number &&
        request.resource.data.guestsCount > 0 &&
        request.resource.data.guestsCount <= 50;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // --- USER FAVORITES ---
    match /userFavorites/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }
  }
}
